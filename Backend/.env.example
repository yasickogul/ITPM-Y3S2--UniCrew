# Copy to .env and fill in real values (never commit .env).

# HTTP port for the API server (avoid 5000 on macOS if AirPlay Receiver uses it).
PORT=5050

# MongoDB connection string (Atlas SRV or local).
# Atlas example:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/DATABASE_NAME?retryWrites=true&w=majority
# Local example:
# MONGO_URI=mongodb://127.0.0.1:27017/unicrew
MONGO_URI=
